# Environment Mode: development | staging | production
APP_ENV=development

# Core Go Service
APP_PORT=8080
JWT_SECRET=supersecretbankkeys1234567890abcdef
JWT_EXPIRE_HOURS=24

# AI FastAPI Service
AI_PORT=8000
AI_SERVICE_URL=http://localhost:8000
CORE_SERVICE_URL=http://localhost:8080

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=bank_sampah_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
